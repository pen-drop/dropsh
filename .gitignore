# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Runtime caches and local CLI state
.drupal-cli/

# Secrets and environment
.env
.env.*
!.env.example

# Per-worktree DDEV override
tests/integrations/drupal/.ddev/config.local.yaml
tests/integrations/drupal/.ddev/.ddev-docker-*
tests/integrations/drupal/.ddev/db_snapshots/
tests/integrations/drupal/.ddev/import-db/
tests/integrations/drupal-schemata/.ddev/config.local.yaml
tests/integrations/drupal-schemata/.ddev/.ddev-docker-*
tests/integrations/drupal-schemata/.ddev/db_snapshots/
tests/integrations/drupal-schemata/.ddev/import-db/

# DDEV runtime-generated files (machine-specific, regenerated on every ddev start)
tests/integrations/drupal/.ddev/traefik/
tests/integrations/drupal/.ddev/addon-metadata/
tests/integrations/drupal-schemata/.ddev/traefik/
tests/integrations/drupal-schemata/.ddev/addon-metadata/

# DDEV-generated Drupal project contents (regenerated by composer install)
tests/integrations/drupal/web/
tests/integrations/drupal/vendor/
tests/integrations/drupal-schemata/web/
tests/integrations/drupal-schemata/vendor/

# Integration-test handover file (contains live credentials)
tests/integrations/drupal/.test-config.json
tests/integrations/drupal-schemata/.test-config.json

# OAuth keys (generated by ddev, must not be committed)
tests/integrations/drupal/keys/
tests/integrations/drupal-schemata/keys/

# Logs
*.log
npm-debug.log*

# OS / IDE
.DS_Store
.idea/
.vscode/
