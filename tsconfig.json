{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "baseUrl": ".",
    "paths": {
      "dropsh/plugin": ["./src/plugin-api.ts"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": [
    "tests/integrations/drupal/web/**",
    "tests/integrations/drupal/vendor/**",
    "tests/integrations/drupal-schemata/web/**",
    "tests/integrations/drupal-schemata/vendor/**"
  ]
}
