From dc54295bc31d957a012c7eac295609d07d71c24b Mon Sep 17 00:00:00 2001
From: Chrisitan Wiedemann <christian.wiedemann@key-tec.de>
Date: Wed, 20 May 2026 01:32:34 +0200
Subject: [PATCH] Issue #0000000: Sanitise SDC props so they compile as valid
 JSON Schema
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Drupal's SDC metadata schema permits PHP class hints — most notably
"Drupal\Core\Template\Attribute" — as a "type" inside a component's
props. The renderer understands those, but they are not valid JSON
Schema types. Any external consumer that runs the serialised props
through a JSON Schema validator (e.g. Ajv) fails to compile the
schema with errors like:

  type must be JSONType or JSONType[]: Drupal\Core\Template\Attribute

Walk the props tree before serialisation and rewrite every "type"
whose value is not in {string, number, integer, boolean, null,
object, array} to "object". Preserve the original value under
"x-drupal-type" so renderer-aware consumers can still see it.

Affected example in core: olivero:teaser declares
  props.properties.attributes.type: Drupal\Core\Template\Attribute

After the fix the same prop is exposed as
  props.properties.attributes.type: object
  props.properties.attributes.x-drupal-type: Drupal\Core\Template\Attribute
---
 src/Resource/SdcComponentResource.php | 52 ++++++++++++++++++++++++++-
 1 file changed, 51 insertions(+), 1 deletion(-)

diff --git a/src/Resource/SdcComponentResource.php b/src/Resource/SdcComponentResource.php
index 654e18f..30ca2dd 100644
--- a/src/Resource/SdcComponentResource.php
+++ b/src/Resource/SdcComponentResource.php
@@ -25,6 +25,24 @@ use Symfony\Component\Routing\Route;
  */
 class SdcComponentResource extends ResourceBase implements ContainerInjectionInterface {
 
+  /**
+   * Valid JSON Schema "type" values per draft-07.
+   *
+   * Drupal's SDC metadata schema additionally allows PHP class hints such
+   * as "Drupal\Core\Template\Attribute" as a "type". Those are not valid
+   * JSON Schema and break any consumer (e.g. Ajv) that tries to compile
+   * the props as a schema.
+   */
+  private const VALID_JSON_SCHEMA_TYPES = [
+    'string',
+    'number',
+    'integer',
+    'boolean',
+    'null',
+    'object',
+    'array',
+  ];
+
   public function __construct(
     protected readonly ComponentPluginManager $componentPluginManager,
   ) {}
@@ -121,7 +139,7 @@ class SdcComponentResource extends ResourceBase implements ContainerInjectionInt
       'description'         => $definition['description'] ?? '',
       'status'              => $definition['status'] ?? 'stable',
       'provider'            => $provider,
-      'props'               => $definition['props'] ?? [],
+      'props'               => $this->sanitizeJsonSchema($definition['props'] ?? []),
       'slots'               => $definition['slots'] ?? [],
       'variants'            => $definition['variants'] ?? [],
     ];
@@ -136,4 +154,36 @@ class SdcComponentResource extends ResourceBase implements ContainerInjectionInt
     );
   }
 
+  /**
+   * Rewrites Drupal-specific type hints to valid JSON Schema types so the
+   * serialised props can be compiled by external consumers.
+   *
+   * Drupal's SDC metadata schema permits PHP class names — most notably
+   * "Drupal\Core\Template\Attribute" — as a "type". Those values are
+   * meaningful to the Drupal renderer but are not valid JSON Schema, so
+   * any client that runs the props through Ajv (or equivalent) fails to
+   * compile the schema. Replace any non-standard type string with
+   * "object" and preserve the original under "x-drupal-type".
+   *
+   * @param mixed $node
+   *   A node from the props/schema tree.
+   *
+   * @return mixed
+   *   The sanitised node.
+   */
+  private function sanitizeJsonSchema(mixed $node): mixed {
+    if (!is_array($node)) {
+      return $node;
+    }
+    foreach ($node as $key => $value) {
+      if ($key === 'type' && is_string($value) && !in_array($value, self::VALID_JSON_SCHEMA_TYPES, TRUE)) {
+        $node['x-drupal-type'] = $value;
+        $node['type'] = 'object';
+        continue;
+      }
+      $node[$key] = $this->sanitizeJsonSchema($value);
+    }
+    return $node;
+  }
+
 }
