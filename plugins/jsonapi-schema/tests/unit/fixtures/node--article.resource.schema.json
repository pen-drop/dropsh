{
  "$schema": "https://json-schema.org/draft/2019-09/hyper-schema",
  "$id": "https://dropsh-test.ddev.site/jsonapi/node/article/resource/schema",
  "title": "Article content item",
  "allOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "#/definitions/type"
        },
        "attributes": {
          "$ref": "#/definitions/attributes"
        },
        "relationships": {
          "$ref": "#/definitions/relationships"
        }
      }
    },
    {
      "$ref": "https://jsonapi.org/schema#/definitions/resource"
    }
  ],
  "definitions": {
    "type": {
      "const": "node--article"
    },
    "attributes": {
      "description": "Entity attributes",
      "type": "object",
      "properties": {
        "drupal_internal__nid": {
          "type": "integer",
          "title": "ID"
        },
        "drupal_internal__vid": {
          "type": "integer",
          "title": "Revision ID"
        },
        "langcode": {
          "type": "string",
          "title": "Language",
          "oneOf": [
            {
              "const": "en",
              "title": "English"
            },
            {
              "const": "und",
              "title": "Not specified"
            },
            {
              "const": "zxx",
              "title": "Not applicable"
            }
          ]
        },
        "revision_timestamp": {
          "type": "string",
          "title": "Revision create time",
          "format": "date-time",
          "description": "The time that the current revision was created."
        },
        "revision_log": {
          "type": "string",
          "title": "Revision log message",
          "description": "Briefly describe the changes you have made.",
          "default": ""
        },
        "status": {
          "type": "boolean",
          "title": "Published",
          "default": true
        },
        "title": {
          "type": "string",
          "title": "Title",
          "maxLength": 255
        },
        "created": {
          "type": "string",
          "title": "Authored on",
          "format": "date-time",
          "description": "The date and time that the content was created."
        },
        "changed": {
          "type": "string",
          "title": "Changed",
          "format": "date-time",
          "description": "The time that the node was last edited."
        },
        "promote": {
          "type": "boolean",
          "title": "Promoted to front page",
          "default": true
        },
        "sticky": {
          "type": "boolean",
          "title": "Sticky at top of lists",
          "default": false
        },
        "default_langcode": {
          "type": "boolean",
          "title": "Default translation",
          "description": "A flag indicating whether this is the default translation.",
          "default": true
        },
        "revision_default": {
          "type": "boolean",
          "title": "Default revision",
          "description": "A flag indicating whether this was a default revision when it was saved."
        },
        "revision_translation_affected": {
          "type": "boolean",
          "title": "Revision translation affected",
          "description": "Indicates if the last edit of a translation belongs to current revision."
        },
        "path": {
          "type": "object",
          "title": "URL alias",
          "properties": {
            "alias": {
              "type": "string",
              "title": "Path alias"
            },
            "pid": {
              "type": "integer",
              "title": "Path id"
            },
            "langcode": {
              "type": "string",
              "title": "Language Code"
            }
          }
        },
        "body": {
          "type": "object",
          "title": "Body",
          "properties": {
            "value": {
              "type": "string",
              "title": "Text"
            },
            "format": {
              "type": "string",
              "title": "Text format"
            },
            "summary": {
              "type": "string",
              "title": "Summary"
            }
          },
          "required": ["value"]
        },
        "comment": {
          "type": "object",
          "title": "Comments",
          "properties": {
            "status": {
              "type": "integer",
              "title": "Comment status"
            },
            "cid": {
              "type": "integer",
              "title": "Last comment ID"
            },
            "last_comment_timestamp": {
              "type": "integer",
              "title": "Last comment timestamp",
              "description": "The time that the last comment was created."
            },
            "last_comment_name": {
              "type": "string",
              "title": "Last comment name",
              "description": "The name of the user posting the last comment."
            },
            "last_comment_uid": {
              "type": "integer",
              "title": "Last comment user ID"
            },
            "comment_count": {
              "type": "integer",
              "title": "Number of comments",
              "description": "The number of comments."
            }
          },
          "required": ["status"],
          "default": {
            "status": 2,
            "cid": 0,
            "last_comment_timestamp": 0,
            "last_comment_name": null,
            "last_comment_uid": 0,
            "comment_count": 0
          }
        }
      },
      "required": ["title"],
      "additionalProperties": false
    },
    "relationships": {
      "description": "Entity relationships",
      "properties": {
        "node_type": {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "required": ["type", "id"],
              "properties": {
                "type": {
                  "type": "string",
                  "title": "Referenced resource",
                  "enum": ["node_type--node_type"]
                },
                "id": {
                  "type": "string",
                  "title": "Resource ID",
                  "format": "uuid",
                  "maxLength": 128
                },
                "meta": {
                  "type": "string",
                  "title": "Content type ID"
                }
              }
            }
          },
          "title": "Content type",
          "links": [
            {
              "href": "{instanceHref}",
              "rel": "related",
              "targetMediaType": "application/vnd.api+json",
              "targetSchema": {
                "$ref": "https://dropsh-test.ddev.site/jsonapi/node/article/resource/relationships/node_type/related/schema"
              },
              "templatePointers": {
                "instanceHref": "/links/related/href"
              },
              "templateRequired": ["instanceHref"]
            }
          ]
        },
        "revision_uid": {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "required": ["type", "id"],
              "properties": {
                "type": {
                  "type": "string",
                  "title": "Referenced resource",
                  "enum": ["user--user"]
                },
                "id": {
                  "type": "string",
                  "title": "Resource ID",
                  "format": "uuid",
                  "maxLength": 128
                },
                "meta": {
                  "type": "integer",
                  "title": "User ID"
                }
              }
            }
          },
          "title": "Revision user",
          "description": "The user ID of the author of the current revision.",
          "links": [
            {
              "href": "{instanceHref}",
              "rel": "related",
              "targetMediaType": "application/vnd.api+json",
              "targetSchema": {
                "$ref": "https://dropsh-test.ddev.site/jsonapi/node/article/resource/relationships/revision_uid/related/schema"
              },
              "templatePointers": {
                "instanceHref": "/links/related/href"
              },
              "templateRequired": ["instanceHref"]
            }
          ]
        },
        "uid": {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "required": ["type", "id"],
              "properties": {
                "type": {
                  "type": "string",
                  "title": "Referenced resource",
                  "enum": ["user--user"]
                },
                "id": {
                  "type": "string",
                  "title": "Resource ID",
                  "format": "uuid",
                  "maxLength": 128
                },
                "meta": {
                  "type": "integer",
                  "title": "User ID"
                }
              }
            }
          },
          "title": "Authored by",
          "description": "The username of the content author.",
          "links": [
            {
              "href": "{instanceHref}",
              "rel": "related",
              "targetMediaType": "application/vnd.api+json",
              "targetSchema": {
                "$ref": "https://dropsh-test.ddev.site/jsonapi/node/article/resource/relationships/uid/related/schema"
              },
              "templatePointers": {
                "instanceHref": "/links/related/href"
              },
              "templateRequired": ["instanceHref"]
            }
          ]
        },
        "field_image": {
          "type": "object",
          "properties": {
            "data": {
              "type": "object",
              "required": ["type", "id"],
              "properties": {
                "type": {
                  "type": "string",
                  "title": "Referenced resource",
                  "enum": ["file--file"]
                },
                "id": {
                  "type": "string",
                  "title": "Resource ID",
                  "format": "uuid",
                  "maxLength": 128
                },
                "meta": {
                  "type": "object",
                  "title": "Image",
                  "properties": {
                    "target_id": {
                      "type": "integer",
                      "title": "File ID"
                    },
                    "alt": {
                      "type": "string",
                      "title": "Alternative text",
                      "description": "Alternative image text, for the image\\'s \\'alt\\' attribute."
                    },
                    "title": {
                      "type": "string",
                      "title": "Title",
                      "description": "Image title text, for the image\\'s \\'title\\' attribute."
                    },
                    "width": {
                      "type": "integer",
                      "title": "Width",
                      "description": "The width of the image in pixels."
                    },
                    "height": {
                      "type": "integer",
                      "title": "Height",
                      "description": "The height of the image in pixels."
                    }
                  },
                  "required": ["target_id"]
                }
              }
            }
          },
          "title": "Image",
          "links": [
            {
              "href": "{instanceHref}",
              "rel": "related",
              "targetMediaType": "application/vnd.api+json",
              "targetSchema": {
                "$ref": "https://dropsh-test.ddev.site/jsonapi/node/article/resource/relationships/field_image/related/schema"
              },
              "templatePointers": {
                "instanceHref": "/links/related/href"
              },
              "templateRequired": ["instanceHref"]
            }
          ]
        },
        "field_tags": {
          "type": "object",
          "properties": {
            "data": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["type", "id"],
                "properties": {
                  "type": {
                    "type": "string",
                    "title": "Referenced resource",
                    "enum": ["taxonomy_term--tags"]
                  },
                  "id": {
                    "type": "string",
                    "title": "Resource ID",
                    "format": "uuid",
                    "maxLength": 128
                  },
                  "meta": {
                    "type": "integer",
                    "title": "Taxonomy term ID"
                  }
                }
              }
            }
          },
          "title": "Tags",
          "description": "Enter a comma-separated list. For example: Amsterdam, Mexico City, \\\"Cleveland, Ohio\\\"",
          "links": [
            {
              "href": "{instanceHref}",
              "rel": "related",
              "targetMediaType": "application/vnd.api+json",
              "targetSchema": {
                "$ref": "https://dropsh-test.ddev.site/jsonapi/node/article/resource/relationships/field_tags/related/schema"
              },
              "templatePointers": {
                "instanceHref": "/links/related/href"
              },
              "templateRequired": ["instanceHref"]
            }
          ]
        }
      },
      "type": "object",
      "additionalProperties": false
    }
  }
}
